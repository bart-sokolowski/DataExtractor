@page
@using System.Linq
@model DataExtractor.Pages.ResultsModel
@{
    ViewData["Title"] = "Detailed view";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="section-title mb-0">Detailed view <span class="count-pill">@Model.Items.Count</span></h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="Index">&larr; Back to listings</a>
        @if (Model.Items.Any())
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#exportPdfModal">Export PDF</button>
        }
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">🏨</div>
        <p class="mb-0">No saved listings yet. Go back and extract some Booking.com links first.</p>
    </div>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="card shadow-sm mb-4 detail-card" id="listing-@item.Id">
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="card-title mb-0">@item.Title</h4>
                            <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">View listing</a>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Location))
                        {
                            if (!string.IsNullOrWhiteSpace(item.MapLink))
                            {
                                <p class="text-muted mb-2"><strong>Location:</strong> <a href="@item.MapLink" target="_blank" rel="noopener noreferrer">@item.Location</a></p>
                            }
                            else
                            {
                                <p class="text-muted mb-2"><strong>Location:</strong> @item.Location</p>
                            }
                        }

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (!string.IsNullOrWhiteSpace(item.Price))
                            {
                                <span class="badge text-bg-success px-3 py-2">Price: @item.Price</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light text-muted px-3 py-2">Price not available</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Occupancy))
                            {
                                <span class="badge text-bg-secondary px-3 py-2">Occupancy: @item.Occupancy</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Rating))
                            {
                                <span class="badge text-bg-info px-3 py-2">Rating: @item.Rating</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="card-text">@item.Description</p>
                        }
                    </div>

                    <div class="col-lg-4">
                        @if (item.HasImages)
                        {
                            <div class="main-image mb-3">
                                <a href="#" class="image-zoom-trigger d-block" data-full="@item.Images[0]">
                                    <img src="@item.Images[0]" alt="Primary image for @item.Title" class="img-fluid rounded w-100 object-fit-cover" style="max-height: 220px;">
                                </a>
                            </div>

                            @if (item.Images.Count > 1)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var image in item.Images.Skip(1).Take(4))
                                    {
                                        @if (!string.IsNullOrWhiteSpace(image))
                                        {
                                            <a href="#" class="image-zoom-trigger" data-full="@image">
                                                <img src="@image" alt="Gallery image for @item.Title" class="rounded thumb-image">
                                            </a>
                                        }
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-secondary" role="alert">
                                Images not available for this listing.
                            </div>
                        }

                        @if (item.HasMap && !string.IsNullOrWhiteSpace(item.MapLink))
                        {
                            <div class="map-container mt-3">
                                @if (!string.IsNullOrWhiteSpace(item.MapImageUrl))
                                {
                                    <a href="@item.MapLink" target="_blank" rel="noopener noreferrer" class="d-block map-image-link">
                                        <img src="@item.MapImageUrl" alt="Map preview for @item.Title" class="img-fluid rounded w-100 map-image object-fit-cover">
                                    </a>
                                    <a href="@item.MapLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary mt-2 w-100">Open in Google Maps</a>
                                }
                                else
                                {
                                    <a href="@item.MapLink" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary w-100">Open in Google Maps</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (Model.Items.Any())
{
    <partial name="_ExportPdfModal" />
}

<div class="modal fade" id="imageZoomModal" tabindex="-1" aria-labelledby="imageZoomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-body p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute end-0 top-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="zoomedImage" src="" alt="Zoomed listing image" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalElement = document.getElementById('imageZoomModal');
            if (!modalElement) {
                return;
            }

            const modalImage = modalElement.querySelector('#zoomedImage');
            const zoomTriggers = document.querySelectorAll('.image-zoom-trigger');

            zoomTriggers.forEach(function (trigger) {
                trigger.addEventListener('click', function (event) {
                    event.preventDefault();
                    const imageUrl = trigger.getAttribute('data-full');
                    if (!imageUrl) {
                        return;
                    }

                    modalImage.src = imageUrl;
                    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.show();
                });
            });

            modalElement.addEventListener('hidden.bs.modal', function () {
                modalImage.src = '';
            });
        });
    </script>
}
